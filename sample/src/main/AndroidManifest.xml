<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:name="${sampleApplication}" android:label="AppArmorX Sample" android:allowBackup="false" android:supportsRtl="true" android:theme="@style/Theme.AppArmorX">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <meta-data android:name="com.apparmorx.security.BLOCK_ACTIVITY" android:value="com.apparmorx.sample.BrandedSecurityActivity" />
        <activity android:name=".BrandedSecurityActivity" android:exported="false" android:excludeFromRecents="true" />
        <activity android:name=".StartupProbeActivity" android:exported="false" />
        <service android:name=".SampleBackgroundService" android:exported="false" />
        <receiver android:name=".SampleSecurityReceiver" android:exported="false" />
        <provider android:name=".SampleContentProvider" android:authorities="${applicationId}.apparmorx.fixture" android:exported="false" />
        <provider android:name=".InheritedContentProvider" android:authorities="${applicationId}.apparmorx.inherited" android:exported="false" />
    </application>
</manifest>
